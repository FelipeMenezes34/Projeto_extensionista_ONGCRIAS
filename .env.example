# Copie este arquivo para ".env" e preencha. Nunca envie o ".env" para o GitHub.

# No nosso computador: DEBUG=True. No site publicado: DEBUG=False
DEBUG=True
SECRET_KEY=troque-por-um-texto-grande-e-aleatorio

# No site publicado, trocar por:
# ALLOWED_HOSTS=ongcrias.org.br,www.ongcrias.org.br
# CSRF_TRUSTED_ORIGINS=https://ongcrias.org.br,https://www.ongcrias.org.br
ALLOWED_HOSTS=127.0.0.1,localhost

# Banco: "sqlite" (só para testar) ou "mysql"
DB_ENGINE=sqlite
DB_NAME=ong_crias
DB_USER=crias_app
DB_PASSWORD=troque_esta_senha
DB_HOST=127.0.0.1
DB_PORT=3306
